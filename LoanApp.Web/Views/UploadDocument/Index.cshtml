@using LoanApp.Web.Models;

@model FileUpload;

<form asp-action="UploadDocument" method="post" enctype="multipart/form-data">
    <br />
    <input asp-for="RequestId" hidden />
    <div class="container border p-3">
        <h1>Upload File</h1>
        <hr />
        <div class="row">
            <div class="col-2">
                <label class="control-label pt-2" style="font-size:20px;">ADHAR CARD</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="File" type="file" class="form-control" />
                <span asp-validation-for="File" class="text-danger"></span>
            </div>
            <div class="col-md-9">
                <button type="button" class="btn btn-danger btn-lg" onclick="window.location.href='@Url.Action("Index", "Home")';">Back To Loan Detail</button>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-success btn-lg" id="apply-loan">Start Process</button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}